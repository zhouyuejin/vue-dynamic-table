{
  "name": "@zhouyuejin1995/vue-dynamic-table",
  "version": "0.1.1",
  "description": "Schema-driven dynamic table for Vue 3 + Element Plus: search form, columns, toolbar, pagination, row selection, fullscreen — all configurable via JSON.",
  "type": "module",
  "license": "MIT",
  "author": "yuejin",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "vue",
    "vue3",
    "element-plus",
    "table",
    "dynamic-table",
    "schema",
    "typescript"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "main": "./dist/vue-dynamic-table.umd.js",
  "module": "./dist/vue-dynamic-table.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-dynamic-table.es.js",
      "require": "./dist/vue-dynamic-table.umd.js"
    },
    "./style.css": "./dist/vue-dynamic-table.css",
    "./styles": "./dist/vue-dynamic-table.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite -c playground/vite.config.ts",
    "build": "vue-tsc --noEmit && vite build",
    "build:lib": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "vue-tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run lint && npm run test && npm run build",
    "release": "./scripts/release.sh",
    "release:patch": "./scripts/release.sh patch",
    "release:minor": "./scripts/release.sh minor",
    "release:major": "./scripts/release.sh major",
    "release:dry": "./scripts/release.sh patch --dry"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "element-plus": "^2.7.0",
    "@element-plus/icons-vue": "^2.3.0"
  },
  "dependencies": {
    "dayjs": "^1.11.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "@vitejs/plugin-vue-jsx": "^4.1.0",
    "element-plus": "^2.8.0",
    "@element-plus/icons-vue": "^2.3.0",
    "happy-dom": "^15.11.0",
    "sass": "^1.83.0",
    "typescript": "~5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^2.1.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.1.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
